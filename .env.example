# ==============================================================================
# useMeter Environment Configuration Template
# ==============================================================================
# Copy this file to .env or load it into your environment before starting.
# For Docker deployments, mount these variables into your compose service.
# ==============================================================================

# Core Application Settings
# ------------------------------------------------------------------------------
# PORT: Port where the useMeter HTTP server listens (default: 3100).
PORT=3100

# DATABASE_PATH: Path to the SQLite database file (default: data/usage.db).
DATABASE_PATH=data/usage.db

# USAGE_MASTER_KEY: 32-byte hex key used to encrypt stored credentials and tokens
# at rest with AES-256-GCM.
# Generate with: openssl rand -hex 32
# WARNING: Do NOT lose or rotate this key after saving credentials, or existing
# stored credentials cannot be decrypted.
USAGE_MASTER_KEY=

# Reverse Proxy & Networking
# ------------------------------------------------------------------------------
# TRUST_PROXY: Set to "true" or "1" when running behind a reverse proxy
# (Nginx, Caddy, Traefik, Cloudflare) so X-Forwarded-Proto,
# X-Forwarded-Host, and client IP headers are correctly evaluated.
TRUST_PROXY=false

# CORS_ALLOWED_ORIGINS: Comma-separated list of allowed origins.
# Defaults to same-origin only if unset.
# CORS_ALLOWED_ORIGINS=https://usemeter.example.com

# Data Retention & Poller Tuning
# ------------------------------------------------------------------------------
# SNAPSHOT_RETENTION_DAYS: How many days of usage snapshot history to retain in SQLite.
# Older snapshots are automatically pruned (default: 7 days).
SNAPSHOT_RETENTION_DAYS=7

# POLL_TIMEOUT_MS: Individual provider refresh deadline in milliseconds (default: 30000).
# POLL_TIMEOUT_MS=30000

# POLL_MAX_CONCURRENT_GLOBAL: Maximum concurrent provider refreshes across all accounts (default: 4).
# POLL_MAX_CONCURRENT_GLOBAL=4

# POLL_MAX_CONCURRENT_PER_PROVIDER: Max concurrent requests per provider (default: 1).
# POLL_MAX_CONCURRENT_PER_PROVIDER=1

# POLL_MIN_PROVIDER_INTERVAL_MS: Minimum interval between polls for the same provider (default: 4000).
# POLL_MIN_PROVIDER_INTERVAL_MS=4000

# Password Reset & Email Recovery (Optional)
# ------------------------------------------------------------------------------
# RECOVERY_MAIL_SOCKET: Path to a Unix domain socket running the rootless mail helper.
# If unset, password reset via email is disabled and admin must reset passwords.
# RECOVERY_MAIL_SOCKET=/run/usemeter/mail-bridge.sock

# Custom OAuth Provider Credentials (Optional)
# ------------------------------------------------------------------------------
# By default, useMeter uses built-in/desktop PKCE flows where possible.
# If you run a custom Google OAuth Web Client, configure it here:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://usemeter.example.com/api/oauth/google/callback

# Hosted Devin OAuth redirect URI (if configured):
# DEVIN_OAUTH_REDIRECT_URI=https://usemeter.example.com/api/oauth/devin/callback
