{
  "name": "usemeter",
  "version": "1.0.0",
  "description": "useMeter — Multi-provider AI usage, credit, and quota tracking dashboard",
  "license": "MIT",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "vite build",
    "dev:client": "vite build --watch",
    "test": "bun test",
    "docker:build": "docker build -t usemeter:local .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
