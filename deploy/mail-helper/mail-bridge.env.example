# useMeter Password Reset Mail Bridge Configuration
# Copy to ~/.config/usemeter/mail-bridge.env on the host machine.
# Operator must supply actual production domain and sender address.

# Canonical HTTPS public origin for password reset links (MANDATORY, no trailing slash)
PUBLIC_ORIGIN=https://usemeter.example.com

# Validated operator sender email address (MANDATORY)
MAIL_SENDER=usemeter@example.com

# Allowed peer UIDs connecting to the Unix socket (1000 = container bun user, 1000 = host murat)
ALLOWED_PEER_UIDS=1000,1000

# Directory group ID for socket permissions (1000 = murat group on host)
SOCKET_GROUP_ID=1000

# Path to sendmail binary on host (default: /usr/sbin/sendmail)
SENDMAIL_BIN=/usr/sbin/sendmail
